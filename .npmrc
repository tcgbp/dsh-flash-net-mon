# Keep these two in sync with pnpm-workspace.yaml, which duplicates them.
# pnpm <= 10 reads only THIS file; pnpm 12 ignores these keys once a
# pnpm-workspace.yaml exists and reads that one instead. Neither file can be
# dropped without regressing the other version — if you change one, change both.
auto-install-peers=false
strict-peer-dependencies=false
